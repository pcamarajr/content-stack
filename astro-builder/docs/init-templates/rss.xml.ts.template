// {{SITE_NAME}} — RSS feed (one endpoint per locale)
//
// Generated by astro-builder (seo-conventions skill). Place a copy of this
// file at src/pages/<locale>/rss.xml.ts for EVERY configured locale — the
// folder gives the endpoint its locale, and context.currentLocale reports it,
// so the file body is identical across locales. BaseLayout advertises the
// feed via <link rel="alternate" type="application/rss+xml">.
import rss from "@astrojs/rss";
import { getCollection } from "astro:content";
import type { APIContext } from "astro";
import { createUrls } from "@lib/urls";

export async function GET(context: APIContext) {
  const locale = context.currentLocale ?? "{{DEFAULT_LOCALE}}";
  // Locale bound once — every link below comes from a url.* method.
  const url = createUrls(locale);

  // Feed only this locale's published entries.
  const entries = await getCollection(
    "{{FEED_COLLECTION}}",
    ({ data }) => data.lang === locale && !data.draft,
  );

  return rss({
    title: "{{SITE_NAME}}",
    description: "{{PROJECT_DESCRIPTION}}",
    // context.site comes from astro.config.ts `site` — mandatory in this stack.
    site: context.site!,
    items: entries
      .toSorted((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
      .map((entry) => ({
        title: entry.data.title,
        description: entry.data.description,
        pubDate: entry.data.date,
        /*
          DELETE THIS COMMENT once the marker below is filled — it is an
          instruction to the generator, not part of the site.

          glob-loader ids include the locale folder ("en/my-article") — the
          stripping happens inside createUrls, since the URL prefix already
          carries the locale, so this endpoint calls a builder and never
          concatenates a path. Fill FEED_ENTRY_URL with the singular builder
          method src/lib/urls.ts exposes for this collection (`url.article`,
          `url.tutorial`, …); if it has none yet, add it there first. The
          public `url.path(...)` primitive is the fallback only when the feed
          is genuinely not a per-entry route.
        */
        link: {{FEED_ENTRY_URL}}(entry.id),
      })),
    customData: `<language>${locale}</language>`,
  });
}
